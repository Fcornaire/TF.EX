<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ModEnablePublish>false</ModEnablePublish>
		<ModEnableZip>false</ModEnableZip>
		<ImplicitUsings>enable</ImplicitUsings>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="FortRise.Configuration" Version="1.5.6" />
		<PackageReference Include="DeepEqual" Version="5.1.0" />
		<PackageReference Include="LazyCache" Version="2.4.0" />
		<PackageReference Include="MessagePack" Version="2.5.302" />
		<PackageReference Include="MessagePackAnalyzer" Version="2.5.302">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

</Project>
